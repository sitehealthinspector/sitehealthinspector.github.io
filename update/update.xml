<?xml version="1.0" encoding="utf-8"?>
<updates>

    <!-- Joomla 4.4.x -->
    <update>
        <name>Site Health Inspector for Joomla</name>
        <description>Site Health Inspector diagnostic, compatibility, and Joomla migration readiness scanner for Joomla.</description>
        <element>com_sitehealth</element>
        <type>component</type>
        <version>0.9.40</version>
        <client>administrator</client>

        <downloads>
            <downloadurl type="full" format="zip">ACTUAL_GITHUB_RELEASE_URL</downloadurl>
        </downloads>

        <infourl>https://sitehealthinspector.github.io/</infourl>

        <tags>
            <tag>stable</tag>
        </tags>

        <maintainer>Dinesh Vaidya</maintainer>
        <maintainerurl>https://sitehealthinspector.github.io/</maintainerurl>

        <targetplatform name="joomla" version="4\.4"/>
        <php_minimum>8.1</php_minimum>

        <sha256>ACTUAL_SHA256</sha256>
    </update>

